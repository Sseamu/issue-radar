# 복사해서 .env 로 저장 후 값 입력
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM: ollama(로컬, 기본) | anthropic | openai
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Gemini 사용 시
# OPENAI_MODEL=gemini-2.5-flash

# 수집 세부
SLICE_DAYS=7
ANALYZE_MONTHS=12
REQUEST_SLEEP=1.0
EMBED_MODEL=BAAI/bge-m3

# Slack (README의 'Slack 설정' 참고)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_BRIEF_CHANNEL=#daily-brief
SLACK_ALERT_CHANNEL=#radar
BRIEF_SECTIONS=IT·과학,경제·증권,정치·사회
# 1 로 두면 PC(아침 배치 또는 상시 봇)가 브리핑 전송. GitHub Actions를 쓰면 0
BRIEF_LOCAL=1

# 아침 배치 (python -m radar.morning)
END_ACTION=shutdown          # shutdown | sleep | none
WAKE_WINDOW=05:30-06:40      # 이 시간대에 시작한 경우에만 자동 종료
MORNING_MAX_MINUTES=65       # 작업 시간 예산: 06:00~07:05 (넘치면 남은 요청은 다음 날로)
EST_ANALYZE_MIN=3            # 키워드 분석 1건 예상 소요(분, 실측 약 2분)
BRIEF_AT=07:00               # 브리핑 전송 시각 (비우면 부팅 직후 전송)
BRIEF_LEAD_MIN=5             # 브리핑을 전송 몇 분 전에 만들기 시작할지
# OLLAMA_EXE=C:\Users\<이름>\AppData\Local\Programs\Ollama\ollama.exe

# 관심 키워드 (처음 한 번만 읽어 DB에 저장. 이후 Slack에서 '@radar 관심 추가/삭제'로 관리)
WATCHLIST=바이오/biotech,AGI/artificial general intelligence
WATCH_SPIKE_RATIO=2.0        # 평소 대비 이 배율 이상이면 급증 → 전체 분석
WATCH_FULL_WEEKDAY=0         # 정기 전체 분석 요일 (0=월 … 6=일, 비우면 안 함)
